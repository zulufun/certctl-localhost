# certctl Agent Configuration - Mẫu cấu hình
# Được tự động tạo bởi install-agent.sh
# File này chứa API Key - hãy bảo vệ cẩn thận! (chmod 600)

# ─── Thông tin Agent ────────────────────────────────────────────────────────
# Agent ID: định danh duy nhất trong fleet (thường là hostname)
CERTCTL_AGENT_ID=ubuntu-apache2-server-01

# Tên hiển thị trên Dashboard
CERTCTL_AGENT_NAME=ubuntu-apache2-server-01

# ─── Kết nối Server ─────────────────────────────────────────────────────────
# Địa chỉ certctl server (BẮT BUỘC - phải là HTTPS)
CERTCTL_SERVER_URL=https://192.168.1.100:8443

# API Key để xác thực (BẮT BUỘC)
CERTCTL_API_KEY=demo-secret-123

# ─── TLS Trust ──────────────────────────────────────────────────────────────
# Nếu server dùng self-signed cert: trỏ đến file server-ca.crt
CERTCTL_SERVER_CA_BUNDLE_PATH=/etc/certctl/server-ca.crt

# Dev/test only - KHÔNG dùng trong production:
# CERTCTL_SERVER_TLS_INSECURE_SKIP_VERIFY=true

# ─── Key Storage ────────────────────────────────────────────────────────────
# Thư mục lưu private keys (agent tạo key cục bộ, không gửi ra ngoài)
CERTCTL_KEY_DIR=/var/lib/certctl/keys
CERTCTL_KEYGEN_MODE=agent

# ─── Discovery ──────────────────────────────────────────────────────────────
# Thư mục scan để tìm certificates hiện có trên máy
CERTCTL_DISCOVERY_DIRS=/etc/apache2/certs,/etc/ssl/certs,/etc/letsencrypt/live

# ─── Logging ────────────────────────────────────────────────────────────────
CERTCTL_LOG_LEVEL=info
