# certctl Agent Configuration - Mẫu cấu hình cho Windows NGINX
# Được tự động tạo bởi install-agent.ps1
# File này chứa API Key - hãy bảo vệ cẩn thận!

# ─── Thông tin Agent ────────────────────────────────────────────────────────
# Agent ID: định danh duy nhất trong fleet (thường là tên máy tính)
# [CÀI ĐẶT DIỆN RỘNG] HÃY ĐỂ TRỐNG để script tự lấy tên máy tính của từng server!
CERTCTL_AGENT_ID=

# Tên hiển thị trên Dashboard
# [CÀI ĐẶT DIỆN RỘNG] HÃY ĐỂ TRỐNG để script tự lấy tên máy tính của từng server!
CERTCTL_AGENT_NAME=

# ─── Kết nối Server ─────────────────────────────────────────────────────────
# Địa chỉ certctl server (BẮT BUỘC - phải là HTTPS)
CERTCTL_SERVER_URL=https://10.1.0.12:8443

# API Key để xác thực (BẮT BUỘC)
CERTCTL_API_KEY=demo-secret-123

# ─── TLS Trust ──────────────────────────────────────────────────────────────
# Nếu server dùng self-signed cert: trỏ đến file server-ca.crt
CERTCTL_SERVER_CA_BUNDLE_PATH=C:\agent-windows-nginx\server-ca.crt

# Dev/test only - KHÔNG dùng trong production:
CERTCTL_SERVER_TLS_INSECURE_SKIP_VERIFY=true

# ─── Key Storage ────────────────────────────────────────────────────────────
# Thư mục lưu private keys (agent tạo key cục bộ, không gửi ra ngoài)
CERTCTL_KEY_DIR=C:\ProgramData\certctl\keys
CERTCTL_KEYGEN_MODE=agent

# ─── Discovery ──────────────────────────────────────────────────────────────
# Thư mục scan để tìm certificates hiện có của NGINX trên Windows
CERTCTL_DISCOVERY_DIRS=C:\nginx\conf,C:\nginx\certs,C:\ssl

# ─── Logging ────────────────────────────────────────────────────────────────
CERTCTL_LOG_LEVEL=info
