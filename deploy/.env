POSTGRES_PASSWORD=demo-password-123
CERTCTL_AUTH_SECRET=demo-secret-123
CERTCTL_API_KEY=demo-secret-123
# Named API keys: format "name:key" or "name:key:admin"
# server-admin → r-admin (full access for dashboard/admin)
# agent-key → r-viewer (will be upgraded to r-agent after boot)
CERTCTL_API_KEYS_NAMED=server-admin:demo-secret-123:admin,agent-key:agent-secret-2026
CERTCTL_CONFIG_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
CERTCTL_BOOTSTRAP_TOKEN=bootstrap-token
CERTCTL_AGENT_BOOTSTRAP_TOKEN=bootstrap-token
CERTCTL_AGENT_BOOTSTRAP_TOKEN_DENY_EMPTY=false
CERTCTL_DEMO_MODE_ACK=true
